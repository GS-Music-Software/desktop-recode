<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gs_music_software.desktop_recode</id>
  <name>GS Music</name>
  <summary>Modern music player and downloader</summary>
  <developer id="io.github.gs_music_software">
    <name>GavinStrikes Software</name>
  </developer>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      GS Music is a music player and downloader built for Linux. It lets you search and download
      tracks from YouTube and SoundCloud directly to your local library, with support for synced
      lyrics, playlists, and a clean immersive player view. Designed to work entirely offline once
      your music is downloaded.
    </p>
  </description>

  <launchable type="desktop-id">gs-music.desktop</launchable>

  <url type="homepage">https://github.com/GS-Music-Software/desktop-recode</url>
  <url type="bugtracker">https://github.com/GS-Music-Software/desktop-recode/issues</url>

  <screenshots>
