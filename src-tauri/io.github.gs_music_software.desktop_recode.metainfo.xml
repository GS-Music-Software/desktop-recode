    </screenshot>
    <screenshot>
      <caption>Discover page for searching and downloading music</caption>
      <image>https://raw.githubusercontent.com/GS-Music-Software/desktop-recode/master/screenshots/discover.png</image>
    </screenshot>
    <screenshot>
      <caption>Built-in equalizer with presets and crossfade support</caption>
