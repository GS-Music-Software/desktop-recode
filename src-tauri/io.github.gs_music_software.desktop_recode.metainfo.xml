    </screenshot>
    <screenshot>
      <caption>Settings page with appearance and audio customization</caption>
      <image>https://raw.githubusercontent.com/GS-Music-Software/desktop-recode/master/screenshots/settings.png</image>
    </screenshot>
  </screenshots>

